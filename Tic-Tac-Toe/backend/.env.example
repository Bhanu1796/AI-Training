# Amzur LiteLLM Proxy
LITELLM_PROXY_URL=https://litellm.amzur.com
LITELLM_API_KEY=sk-your-key-here
LLM_MODEL=gemini/gemini-2.5-flash

# Agent behaviour: llm | minimax | random
AGENT_MODE=llm
AGENT_EXPLAIN=true

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tictactoe

# App
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
